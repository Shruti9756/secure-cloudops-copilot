POSTGRES_USER=securecloudops
POSTGRES_PASSWORD=local-dev-only-change-me
POSTGRES_DB=securecloudops

DATABASE_URL=postgresql+psycopg://securecloudops:local-dev-only-change-me@127.0.0.1:5432/securecloudops
REDIS_URL=redis://127.0.0.1:6379/0

# Profile names are safe to reference, but access keys must never be committed.
AWS_PROFILE=your-aws-cli-profile
AWS_REGION=us-east-1

# Local scripts reach Ollama through the host port; containers use the Compose service address.
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Per-client protection for the costly AI question endpoint.
ASK_RATE_LIMIT_REQUESTS=10
ASK_RATE_LIMIT_WINDOW_SECONDS=60