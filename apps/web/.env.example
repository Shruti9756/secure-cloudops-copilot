# Public, browser-visible URL of the FastAPI backend for local development.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Leave blank to keep local identity mode and hide the browser sign-in button.
NEXT_PUBLIC_COGNITO_MANAGED_LOGIN_BASE_URL=
NEXT_PUBLIC_COGNITO_CLIENT_ID=
NEXT_PUBLIC_COGNITO_REDIRECT_URI=

# Browser-selected workspace. The API verifies membership before granting access.
NEXT_PUBLIC_WORKSPACE_SLUG=nimbuscart