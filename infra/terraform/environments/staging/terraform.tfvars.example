aws_profile    = "your-aws-cli-profile"
aws_region     = "us-east-1"
aws_account_id = "123456789012"

environment = "staging"
runtime_enabled = false
owner       = "your-name-or-team"
cost_center = "personal-learning"
network_vpc_cidr           = "10.41.0.0/16"
network_availability_zones = ["us-east-1a", "us-east-1b"]
# Leave blank while staging runtime is off. Do not use development Cognito values.
staging_cognito_issuer        = ""
staging_cognito_app_client_id = ""
# Leave blank until the real staging CloudFront HTTPS address exists.
staging_frontend_origin = ""